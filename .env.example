# ETF-Insight 环境变量配置
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ========== API Keys ==========

# Finage API Key (ETF主要数据源，必须配置)
# 申请地址: https://finage.co.uk/
FINAGE_API_KEY=your_finage_api_key_here

# Finnhub API Key (ETF备用数据源，可选)
# 申请地址: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# ========== 外汇数据源 API Keys ==========

# Open Exchange Rates API Key (汇率主数据源，推荐配置)
# 免费额度: 每月1000次请求，支持200+货币，每小时更新
# 申请地址: https://openexchangerates.org/
OPENEXCHANGE_API_KEY=your_openexchange_api_key_here

# CurrencyAPI Key (汇率第一备份数据源，推荐配置)
# 免费额度: 每月10000次请求，支持170+货币，每日更新
# 申请地址: https://currencyapi.com/
CURRENCYAPI_KEY=your_currencyapi_key_here

# Frankfurter (汇率第二备份数据源，免费无需API Key)
# 无限请求，支持30+货币，每日更新
# 不需要API Key，自动可用

# ========== 代理配置 ==========

# 如果需要代理访问外部API，取消注释以下配置
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# ========== QuantLib API 配置 ==========
QUANTLIB_API_URL=https://api.fincept.in/quantlib
QUANTLIB_API_KEY=your_quantlib_api_key_here
