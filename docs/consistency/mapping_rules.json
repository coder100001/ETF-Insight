{
  "version": "1.0.0",
  "last_updated": "2026-04-24",
  "mapping_rules": {
    "backend": {
      "description": "后端服务代码与文档映射规则",
      "modules": {
        "handlers": {
          "document_section": "API接口定义",
          "description": "HTTP请求处理器，对应RESTful API接口",
          "required_documentation": ["功能说明", "请求参数", "响应格式", "错误码"]
        },
        "services": {
          "document_section": "业务逻辑实现", 
          "description": "核心业务逻辑服务层",
          "required_documentation": ["功能描述", "输入参数", "输出结果", "算法说明"]
        },
        "models": {
          "document_section": "数据模型定义",
          "description": "数据库模型和数据结构",
          "required_documentation": ["字段说明", "数据类型", "约束条件", "关联关系"]
        },
        "middleware": {
          "document_section": "中间件功能",
          "description": "HTTP请求处理中间件",
          "required_documentation": ["功能说明", "配置参数", "使用示例"]
        }
      },
      "specific_mappings": {
        "ETFHandler": {
          "document_files": ["README.md", "backend/README.md"],
          "sections": ["ETF分析功能", "API接口"],
          "description": "ETF数据获取和分析处理器"
        },
        "PortfolioHandler": {
          "document_files": ["README.md", "backend/README.md"], 
          "sections": ["投资组合分析", "组合优化"],
          "description": "投资组合管理和分析处理器"
        },
        "ETFAnalysisService": {
          "document_files": ["README.md", "backend/README.md"],
          "sections": ["量化分析引擎", "技术指标"],
          "description": "ETF量化分析核心服务"
        },
        "Asset": {
          "document_files": ["README.md", "backend/README.md"],
          "sections": ["统一资产模型", "数据层重构"],
          "description": "统一资产基表模型"
        }
      }
    },
    "frontend": {
      "description": "前端应用代码与文档映射规则", 
      "modules": {
        "components": {
          "document_section": "UI组件",
          "description": "React UI组件",
          "required_documentation": ["组件功能", "Props参数", "使用示例"]
        },
        "pages": {
          "document_section": "页面功能",
          "description": "页面级组件和功能",
          "required_documentation": ["页面功能", "路由配置", "数据流"]
        },
        "services": {
          "document_section": "API服务",
          "description": "前端API调用服务",
          "required_documentation": ["接口说明", "参数格式", "错误处理"]
        },
        "types": {
          "document_section": "类型定义", 
          "description": "TypeScript类型定义",
          "required_documentation": ["类型说明", "使用场景"]
        }
      },
      "specific_mappings": {
        "ETFComparison": {
          "document_files": ["README.md", "frontend/README.md"],
          "sections": ["ETF对比分析", "可视化功能"],
          "description": "ETF多维度对比组件"
        },
        "PortfolioAnalysis": {
          "document_files": ["README.md", "frontend/README.md"],
          "sections": ["投资组合分析", "情景分析"],
          "description": "投资组合分析页面"
        },
        "apiService": {
          "document_files": ["frontend/README.md"],
          "sections": ["API集成", "数据获取"],
          "description": "前端API服务"
        }
      }
    }
  },
  "feature_mappings": {
    "etf_analysis": {
      "code_indicators": ["ETFHandler", "ETFAnalysisService", "etf_analysis.go"],
      "document_sections": ["ETF分析功能", "量化分析引擎"],
      "required": true
    },
    "portfolio_optimization": {
      "code_indicators": ["PortfolioHandler", "portfolio_optimizer.go", "optimization/"],
      "document_sections": ["投资组合优化", "马科维茨MPT", "风险平价"],
      "required": true
    },
    "backtest_engine": {
      "code_indicators": ["backtest/", "BacktestHandler"],
      "document_sections": ["回测引擎", "事件驱动架构"],
      "required": true
    },
    "factor_analysis": {
      "code_indicators": ["factor/", "FamaFrench"],
      "document_sections": ["因子分析", "Fama-French模型"],
      "required": true
    },
    "a_share_support": {
      "code_indicators": ["ashare/", "ASharePortfolioHandler"],
      "document_sections": ["A股ETF支持", "中证红利"],
      "required": true
    },
    "penetration_analysis": {
      "code_indicators": ["portfolio_penetration.go", "holdings_service.go"],
      "document_sections": ["持仓穿透分析", "组合穿透"],
      "required": true
    }
  },
  "version_consistency": {
    "sources": {
      "readme": {
        "files": ["README.md", "README_EN.md"],
        "pattern": "v(\\d+\\.\\d+\\.\\d+)"
      },
      "package": {
        "files": ["package.json"],
        "pattern": "version"
      },
      "backend": {
        "files": ["backend/go.mod", "backend/config.yaml"],
        "pattern": "v(\\d+\\.\\d+\\.\\d+)"
      }
    }
  },
  "validation_rules": {
    "required_documents": ["README.md", "AGENTS.md", "backend/README.md", "frontend/README.md"],
    "min_coverage_threshold": 0.8,
    "high_severity_issues": ["missing_code_element", "version_mismatch", "unimplemented_feature"],
    "check_frequency": "pre_commit"
  }
}